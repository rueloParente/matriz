{
  "uid": "matriz",
  "title": "Matriz — application overview",
  "tags": ["matriz", "homelab"],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "time": {"from": "now-1h", "to": "now"},
  "timezone": "browser",
  "panels": [
    {
      "id": 1, "title": "Scrape availability", "type": "stat",
      "description": "1 = scrape successful, 0 = scrape failed. This is not an application readiness probe.",
      "gridPos": {"x": 0, "y": 0, "w": 8, "h": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "up{job=\"matriz\"}"}],
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []}
    },
    {
      "id": 2, "title": "HTTP requests / second", "type": "timeseries",
      "gridPos": {"x": 8, "y": 0, "w": 8, "h": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{job=\"matriz\",uri!~\"/actuator.*\"}[$__rate_interval]))"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []}
    },
    {
      "id": 3, "title": "HTTP 5xx / second", "type": "timeseries",
      "gridPos": {"x": 16, "y": 0, "w": 8, "h": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{job=\"matriz\",status=~\"5..\",uri!~\"/actuator.*\"}[$__rate_interval])) or (0 * sum(rate(http_server_requests_seconds_count{job=\"matriz\",uri!~\"/actuator.*\"}[$__rate_interval])))"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []}
    },
    {
      "id": 4, "title": "Mean HTTP latency", "type": "timeseries",
      "description": "Request-weighted mean, excluding scrapes. No value when there is no traffic.",
      "gridPos": {"x": 0, "y": 5, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(rate(http_server_requests_seconds_sum{job=\"matriz\",uri!~\"/actuator.*\"}[$__rate_interval])) / sum(rate(http_server_requests_seconds_count{job=\"matriz\",uri!~\"/actuator.*\"}[$__rate_interval]))"}],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}
    },
    {
      "id": 5, "title": "JVM heap", "type": "timeseries",
      "gridPos": {"x": 12, "y": 5, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum(jvm_memory_used_bytes{job=\"matriz\",area=\"heap\"})", "legendFormat": "Used"},
        {"refId": "B", "expr": "sum(jvm_memory_committed_bytes{job=\"matriz\",area=\"heap\"})", "legendFormat": "Committed"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0}, "overrides": []}
    },
    {
      "id": 6, "title": "Process CPU", "type": "timeseries",
      "gridPos": {"x": 0, "y": 13, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "process_cpu_usage{job=\"matriz\"}", "legendFormat": "{{instance}}"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}
    },
    {
      "id": 7, "title": "Database connections", "type": "timeseries",
      "gridPos": {"x": 12, "y": 13, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "hikaricp_connections_active{job=\"matriz\"}", "legendFormat": "{{pool}} active"},
        {"refId": "B", "expr": "hikaricp_connections_idle{job=\"matriz\"}", "legendFormat": "{{pool}} idle"},
        {"refId": "C", "expr": "hikaricp_connections_max{job=\"matriz\"}", "legendFormat": "{{pool}} max"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []}
    }
  ]
}
